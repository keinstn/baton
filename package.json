{
  "name": "baton",
  "version": "0.1.0",
  "description": "Conducts coding agents against a GitHub Projects board (Symphony-derived orchestrator)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "baton": "dist/cli.js",
    "baton-dashboard": "dist/dashboard/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "changeset": "changeset",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "version-packages": "changeset version && npm install --package-lock-only"
  },
  "dependencies": {
    "liquidjs": "^10.21.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
